APP_NAME=Asahi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DOMAIN=asahiplay.com
APP_URL=https://asahiplay.com
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=asahi
DB_USERNAME=asahi
DB_PASSWORD=GANTI_PASSWORD_KUAT
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_KUAT

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://asahiplay.com/auth/google/callback

# Naskah & gambar IKSC milik KPM: biarkan false sampai ada izin tertulis
ASAHI_IKSC_PUBLIC=false
